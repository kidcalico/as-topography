---
import type { string } from "astro:schema";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    postNumber: number;
    pubDate: Date;
    lastEdit: Date;
    title: string;
    description: string;
    author: string;
    image: {
      url: string;
      alt: string;
    }
    tags: string[];
  }
}

const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
  {frontmatter.image && <img src={frontmatter.image.url} alt={frontmatter.image.alt} class="post-image" />}
  <h1>{frontmatter.title}</h1>
  <p class="post-info">Written by {frontmatter.author}<br />on {frontmatter.pubDate.toString().slice(0,10)}</p>
  <div class="post-content">
    <slot />
    <div class="tags">
      <p>
        Tags: 
        {frontmatter.tags.map((tag) => (
          <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
      </p>
    </div>
  </div>
  <p class="last-edit">Last edited on {frontmatter.lastEdit.toString().slice(0,10)}</p>
</BaseLayout>
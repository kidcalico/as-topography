---
import LandingLayout from '../layouts/LandingLayout.astro';

const pageTitle = "Welcome";
---
<LandingLayout pageTitle={pageTitle}>
	<div class="hero">
		<h1>{pageTitle}</h1>
		<div class="hero-image">
			<img src="/images/brown_sun.svg" alt="A yellow sun pictograph with fourteen arms.">
		</div>
		<div class="p5sketch"></div>
		<script is:inline src="/scripts/p5.min.js"></script>
		<script is:inline src="/scripts/topographical-waves.js"></script>
	</div>
</LandingLayout>